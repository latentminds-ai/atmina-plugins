{
  "description": "Atmina memory: orient on the Knowledge Base at session start, notice durable work that was never written down, and hand session starts and ends to the local collector on a device where capture is enabled.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ". \"${CLAUDE_PLUGIN_ROOT}/hooks/orient.cmd\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": ". \"${CLAUDE_PLUGIN_ROOT}/hooks/capture-start.cmd\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__(atmina|plugin_atmina_atmina)__(write_file|write_files|update_file|upload_file|confirm_uploads)$",
        "hooks": [
          {
            "type": "command",
            "command": ". \"${CLAUDE_PLUGIN_ROOT}/hooks/record-write.cmd\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ". \"${CLAUDE_PLUGIN_ROOT}/hooks/record-compaction.cmd\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ". \"${CLAUDE_PLUGIN_ROOT}/hooks/nudge.cmd\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ". \"${CLAUDE_PLUGIN_ROOT}/hooks/capture-end.cmd\""
          }
        ]
      }
    ]
  }
}
