{
  "description": "Atmina memory: orient on the Knowledge Base at session start, and notice durable work that was never written down.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/orient.sh\"",
            "commandWindows": "cmd.exe /d /c call \"%SystemRoot%/System32/WindowsPowerShell/v1.0/powershell.exe\" -NoProfile -NonInteractive -ExecutionPolicy Bypass -EncodedCommand ",
            "statusMessage": "Atmina: orienting on memory",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__(atmina|plugin_atmina_atmina)__(write_file|write_files|update_file|upload_file|confirm_uploads)$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/record-write.sh\"",
            "commandWindows": "cmd.exe /d /c call \"%SystemRoot%/System32/WindowsPowerShell/v1.0/powershell.exe\" -NoProfile -NonInteractive -ExecutionPolicy Bypass -EncodedCommand ",
            "statusMessage": "Atmina: recording write",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/record-compaction.sh\"",
            "commandWindows": "cmd.exe /d /c call \"%SystemRoot%/System32/WindowsPowerShell/v1.0/powershell.exe\" -NoProfile -NonInteractive -ExecutionPolicy Bypass -EncodedCommand ",
            "statusMessage": "Atmina: recording compaction",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/nudge-prompt.sh\"",
            "commandWindows": "cmd.exe /d /c call \"%SystemRoot%/System32/WindowsPowerShell/v1.0/powershell.exe\" -NoProfile -NonInteractive -ExecutionPolicy Bypass -EncodedCommand ",
            "statusMessage": "Atmina: memory nudge",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
