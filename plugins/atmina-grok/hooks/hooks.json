{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^atmina__(write_file|write_files|update_file|upload_file|confirm_uploads)$",
        "hooks": [
          {
            "type": "command",
            "command": ". \"${GROK_PLUGIN_ROOT}/hooks/record-write.cmd\"",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": ". \"${GROK_PLUGIN_ROOT}/hooks/post-tool.cmd\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ". \"${GROK_PLUGIN_ROOT}/hooks/record-compaction.cmd\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ". \"${GROK_PLUGIN_ROOT}/hooks/cleanup.cmd\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
